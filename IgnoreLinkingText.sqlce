CREATE TABLE [IgnoreLinkingTexts] (
  [Id] int IDENTITY (1,1) NOT NULL
, [IgnoreText] nvarchar(100) NULL
, [ProfileId] int NULL
, CONSTRAINT [FK_Profile_ToLikingText] FOREIGN KEY ([ProfileId]) REFERENCES [PrintProfiles]([Id]) ON DELETE CASCADE 
);
