<%@ Page language="c#" Inherits="RenderFirstPage._Default" %>

<HTML>
      <div id="Layer1" style="position:absolute; left:156px; top:85px; width:292px; height:123px; z-index:1; border:2px solid #999999; text-align:center; vertical-align:middle; visibility: hidden; background-color:#eeeeee">
         <strong>Uploading PDF</strong><br>
         <img src="img/upload-ani.gif" width="272" height="60" /><br>
            This may take a couple of seconds depending on available bandwidth...
      </div>
      <form method="post" runat="server" enctype="multipart/form-data" ID="Form1">
         <h1>PDFRasterizer.NET Live Demo </h1>
         <P>Upload a PDF file and see the conversion result.</P>
         <input width="100%" type="file" size="50" name="pdf" maxlength="250000" /> 
         (250kb Max)
         <p>
            <asp:CheckBox runat="server" ID="CheckAntiAlias" Text="AntiAliased" Checked="true"/>
            <asp:RadioButton runat="server" id="Radio72" GroupName="Resolution" Text="72 dpi" Checked="true"/>
            <asp:RadioButton runat="server" id="Radio48" GroupName="Resolution" Text="48 dpi" Value="48"/>
         </p>
			<p>
			   Image format: 
            <asp:DropDownList ID="ListFormat" runat="server"></asp:DropDownList>
         </p>
         <asp:button Runat="server" Text="Convert first page" ID="ConvertPdf" OnClick="Convert_Click" />
         <p>
            <i>Currently running <%= GetProductAndVersionName("TallComponents.PDF.Rasterizer") %></i>
         </p>
         <asp:panel runat="server" id="PanelResult" visible='<%# RenderCompleted %>'>
         <h2>Conversion result</h2>
         <p>
            <asp:Label runat="server" Text='<%# String.Format( "Rendering took {0:###0.000} seconds (including GDI+ Bitmap creation with AntiAliasing)", RenderTime.TotalSeconds ) %>'/>
         </p>
         <asp:Image runat="server" AlternateText="Image generated by PDFrasterizer.NET"
                    ImageUrl='<%# "default.aspx?image="+DateTime.Now.Ticks.ToString()+"&name=/converted."+ListFormat.SelectedValue.ToLower() %>'
                    BorderWidth="1" BorderStyle="Solid" BackColor="0xAAAAAA"/>
         </asp:panel>
      </form>
</HTML>
