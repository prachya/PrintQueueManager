<Window x:Class="WpfApplication1.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Window1" Height="300" Width="300" Topmost="False">
    <DockPanel>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Menu Height="20" Grid.Row="0">
                <MenuItem Header="File">
                    <MenuItem Header="Select..." Click="MenuItemOpen"></MenuItem>
                    <Separator/>
                    <MenuItem Header="Quit" Click="MenuItemQuit"></MenuItem>
                </MenuItem>
        </Menu>
        
        <Button Name="ConvertToXPSButton" Grid.Row="1" Height="Auto" ToolTip="Convert to XPS..." Click="MenuItemSaveXpsStreamed">Convert To XPS...</Button>
        
        <StatusBar Name="StatusBar" Height="20" Grid.Row="2" Width="Auto">
                <TextBlock Name="Progess"></TextBlock>
        </StatusBar>
    </Grid>
    </DockPanel>
</Window>
