<Window x:Class="ScaledPrintingWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" 
        mc:Ignorable="d" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:ScaledPrintingWPF"
        xmlns:Printing="clr-namespace:System.Printing;assembly=ReachFramework" d:DesignHeight="614" 
        d:DesignWidth="584" 
        SizeToContent="WidthAndHeight">
    <Window.DataContext>
        <c:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Height="585" Width="578" >
        <Grid.Resources>
            <c:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </Grid.Resources>

        <Menu Name="MenuFile" 
              Height="21" Width="53" 
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,1,0,0" >
            <MenuItem Header="File" Click="MenuItem_Click">
                <MenuItem Header="Open..." 
                Click="MenuFileOpen" />
            </MenuItem>
        </Menu>

        <!-- label and combobox for the printer selection -->
        <Label Name="labelPrinterList" Content="Select a printer" 
                  Height="30" Width="240" Margin="20,36,0,0"
                  HorizontalAlignment="Left"  VerticalAlignment="Top" />
        <ComboBox Name="ComboPrinterList" 
                  Height="22"  
                  Width="250" 
                  Margin="20,60,0,0" 
                  ItemsSource="{Binding InstalledPrinters}"
                  DisplayMemberPath="Name"
                  SelectedValue="{Binding SelectedPrinter, Mode=TwoWay}"
                  HorizontalAlignment="Left"  
                  VerticalAlignment="Top" 
                  IsSynchronizedWithCurrentItem="True"/>

        <!-- label and combobox for the paper size selection -->
        <Label Name="labelPaperSizeList" Content="Select paper size" 
                  Height="30" Width="240" Margin="20,96,0,0" 
                  HorizontalAlignment="Left" VerticalAlignment="Top"  />
        <ComboBox Name="ComboPaperSizeList"
                  Height="22" 
                  Width="250" 
                  Margin="20,120,0,0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  ItemsSource="{Binding PrinterPaperSizes}"
                  DisplayMemberPath="PageMediaSizeName"
                  SelectedItem="{Binding Path=SelectedPaperSize, Mode=TwoWay}"
                  IsSynchronizedWithCurrentItem="True"/>

        <!-- label and combobox for the paper source selection -->
        <Label Name="labelPaperSourceList" Content="Select paper source" 
                  Height="30" 
                  Width="240" 
                  Margin="20,156,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" />
        <ComboBox Name="ComboPaperSourceList" 
                  Height="22" 
                  Width="250" 
                  Margin="20,180,0,0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top"
                  ItemsSource="{Binding Path=PrinterPaperSources}"
                  SelectedValue="{Binding Path=SelectedPaperSource, Mode=TwoWay}"
                  IsSynchronizedWithCurrentItem="True" />

        <!-- label and radio buttons for the vertical alignment -->
        <Grid
            Height="60" 
            Width="250" 
            Margin="20,216,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >
            <Label Content="Vertical alignment" 
                   Margin="0,0,0,0" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" />

            <RadioButton Name="RadioButtonVerticalAlignmentTop" 
                   Content="Top"
                   Margin="130,5,0,0" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   IsChecked="{Binding Path=PrintPdfVerticalAlignment, 
                                       Converter={StaticResource EnumToBooleanConverter}, 
                                       ConverterParameter={x:Static VerticalAlignment.Top}}" />

            <RadioButton Name="RadioButtonVerticalAlignmentCenter" 
                  Content="Center"
                  Margin="130,23,0,0" 
                  HorizontalAlignment="Left"  
                  VerticalAlignment="Top"
                  IsChecked="{Binding Path=PrintPdfVerticalAlignment, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static VerticalAlignment.Center}}" />

            <RadioButton Name="RadioButtonVerticalAlignmentBottom"  
                  Content="Bottom"
                  Margin="130,41,0,0" 
                  HorizontalAlignment="Left"  
                  VerticalAlignment="Top"
                  IsChecked="{Binding Path=PrintPdfVerticalAlignment, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static VerticalAlignment.Bottom}}" />
        </Grid>

        <!-- label and radio buttons for the horizontal alignment -->
        <Grid
            Height="60" 
            Width="250" 
            Margin="20,291,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >
            <Label Content="Horizontal alignment" 
                   Margin="0,0,0,0"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" />

            <RadioButton Name="RadioButtonHorizontalAlignmentLeft" 
                  Content="Left"
                  Margin="130,5,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfHorizontalAlignment, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static HorizontalAlignment.Left}}" />

            <RadioButton Name="RadioButtonHorizontalAlignmentCenter"
                  Content="Center" 
                  Margin="130,23,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfHorizontalAlignment, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static HorizontalAlignment.Center}}" />

            <RadioButton Name="RadioButtonHorizontalAlignmentRight"
                  Content="Right" 
                  Height="16" 
                  Margin="130,41,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfHorizontalAlignment, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static HorizontalAlignment.Right}}" />

        </Grid>

        <!-- label and radio buttons for the orientation -->
        <Grid
            Height="60" 
            Width="250" 
            Margin="20,366,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >
            <Label Content="PdfOrientation" 
                  Margin="0,0,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" />
       
            <RadioButton Name="RadioButtonOrientationPortrait"
                  Content="Portrait"
                  Margin="130,5,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfOrientation, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static Printing:PageOrientation.Portrait}}" />

            <RadioButton  Name="RadioButtonOrientationLandscape"
                  Content="Landscape" 
                  Height="16" 
                  Margin="130,23,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfOrientation, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static Printing:PageOrientation.Landscape}}" />

            <RadioButton  Name="RadioButtonOrientationAutomatic"
                  Content="Automatic" 
                  Height="16" 
                  Margin="130,41,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintPdfOrientation, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static Printing:PageOrientation.Unknown}}" />

        </Grid>
   

        <!-- label and checkboxes for the options -->
        <Grid
            Height="60" 
            Width="250" 
            Margin="20,441,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >

            <Label Content="Options"
                  Margin="0,0,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" />

            <CheckBox Name="CheckBoxScaleToFit"
                  Content="Scale to fit" 
                  Margin="130,5,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=ScaleToFit, Mode=TwoWay}" />
            
            <CheckBox Name="CheckBoxUsePrintableArea"
                  Content="Use printable area" 
                  Margin="130,23,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=UsePrintableArea, Mode=TwoWay}" />
            
            <CheckBox Name="CheckBoxDuplex"
                  Content="Print duplex" 
                  Height="16"  
                  Margin="130,41,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  IsChecked="{Binding Path=PrintDuplex, Mode=TwoWay}" />
        </Grid>

        <!-- label checkboxes and textboxes for the range of the number of pages -->
        <Grid
            Height="64" 
            Width="250" 
            Margin="20,516,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >
            
            <Label Content="Pages" 
                  Height="28" Margin="0,0,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" />

            <RadioButton Name="RadioButtonPagesAll"
                  Content="All"
                  Margin="130,5,0,0" 
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left" 
                  IsChecked="{Binding Path=PrintPageRange, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static c:PrintPageRange.All}}" />

            <RadioButton Name="RadioButtonPagesCurrent"
                  Content="Current"
                  Margin="130,23,0,0" 
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left" 
                  IsChecked="{Binding Path=PrintPageRange, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static c:PrintPageRange.Current}}" />

            <RadioButton 
                  Name="RadioButtonPagesRange"
                  Content="" 
                  Margin="130,41,0,0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top"
                  IsChecked="{Binding Path=PrintPageRange, 
                                      Mode=TwoWay, 
                                      Converter={StaticResource EnumToBooleanConverter}, 
                                      ConverterParameter={x:Static c:PrintPageRange.Range}}" />

            <TextBox Name="TextboxPagesRangeFrom"
                  Height="24" 
                  Width="40" 
                  Margin="144,41,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Text="{Binding Path=PrintRangeFirst,
                                 Mode=TwoWay, 
                                 UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox Name="TextboxPagesRangeTo"
                  Height="24" 
                  Width="40" 
                  Margin="187,41,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Text="{Binding Path=PrintRangeLast, 
                                 Mode=TwoWay, 
                                 UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- label and viewbox for the preview -->
        <Label  Name="labelDocumentName" 
                  Height="60" 
                  Width="258" 
                  Margin="292,0,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top"
                  VerticalContentAlignment="Bottom"
                  Content="{Binding CurrentFileName, Mode=TwoWay}"/>
        <Viewbox Name="viewboxPreview"
                  Height="310" 
                  Margin="300,60,0,0" 
                  Width="250"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top">
            <ContentPresenter Content="{Binding Path=PreviewOfOnePdfPage}"/>
        </Viewbox>

        <!-- label, buttons, textbox and slider to select the previewed page number -->
        <Grid
            Height="35" 
            Width="250" 
            Margin="300,375,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" >

            <Button FontFamily="Marlett" FontSize="20" Content="3"
                  Height="22"  
                  Width="22" 
                  Margin="0,1,0,0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Padding="0" 
                  Click="ButtonPreviousPage"/>
            
            <TextBox 
                  Name="TextboxCurrentPageNumber"
                  Height="24"  
                  Width="45" 
                  Margin="22,0,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Text="{Binding Path=CurrentPageNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Button FontFamily="Marlett" FontSize="20" Content="4"
                  Height="22"  
                  Width="22" 
                  Margin="67,1,0,0" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top" 
                  Padding="0"
                  Click="ButtonNextPage"/>

            <Slider 
                  Height="31"
                  Width="158" Margin="91,1,0,0"
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Top"
                  HorizontalContentAlignment="Right"
                  Value="{Binding Path=CurrentPageNumber, Mode=TwoWay}" 
                  Minimum="1"
                  Maximum="{Binding Path=MaximumPageNumber, Mode=OneWay}" />
        </Grid>    

        <!-- textbox for the previewed page information -->
        <Label  Name="LabelDocumentInfo" 
                Height="121" 
                Width="258" 
                Margin="292,413,0,0"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Content="{Binding Path=DocumentInformation, Mode=TwoWay}" /> 

        <!-- Print and cancel button -->
        <Button Name="buttonPrint" Content="Print" 
                Height="26"  Width="110" Margin="300,539,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Click="ButtonPrintPressed" />
        
        <Button Name="buttonCancel" Content="Cancel" 
                Height="26" Width="110" Margin="439,539,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Click="ButtonCancelPressed"/>
    </Grid>
</Window>
