<Window x:Class="Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Window1" Height="300" Width="300">
   <DockPanel Name="Panel" Width="Auto" Height="Auto" LastChildFill="True" >
      <Menu Height="20" DockPanel.Dock="Top">
         <MenuItem Header="File">
            <MenuItem Header="Open..." Click="MenuItem_Open"></MenuItem>
            <MenuItem Header="Save as XPS..." Click="MenuItem_SaveXPS"></MenuItem>
            <Separator/>
            <MenuItem Header="Quit" Click="MenuItem_Quit"></MenuItem>
         </MenuItem>
      </Menu>
      <DocumentViewer Name="DocumentViewer"></DocumentViewer>
   </DockPanel>
</Window>
